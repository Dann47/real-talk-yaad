{
  "expo": {
    "name": "Real Talk Yaad",
    "slug": "real-talk-yaad",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "realtalkyaad",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07805C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Real Talk Yaad",
      "shortName": "Real Talk Yaad",
      "description": "Teach AI real Jamaican Patois and get paid.",
      "backgroundColor": "#0A0F0D",
      "themeColor": "#0A0F0D"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0F0D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Real Talk Yaad to use your microphone for voice chats and recordings."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Real Talk Yaad uses your photos so you can post them to the Feed for others to describe in Patois.",
          "cameraPermission": "Real Talk Yaad uses the camera so you can take photos and short videos for the Feed.",
          "microphonePermission": "Real Talk Yaad uses the microphone to record sound with your Feed videos."
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
