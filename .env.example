# Copy this file to .env.development (and later .env.production) and fill in the values.
# Find them in Supabase: Project Settings > API Keys (publishable key) and Project Settings > Data API (URL).
# Only the PUBLISHABLE key goes here. Never put the secret / service_role key in the app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
