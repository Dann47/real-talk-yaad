# Real Talk Yaad settings: TEMPLATE. Copy to .env.development or .env.production and fill in
# This file is NOT committed to Git. Keep a copy in your password manager.

# ---------------------------------------------------------------------------
# App settings (built into the app; safe to be public)
# Supabase: Project Settings > Data API (URL) and Project Settings > API Keys (publishable key).
# Never put the secret / service_role key here.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Which Supabase project the secrets below are sent to (the code in https://CODE.supabase.co)
# ---------------------------------------------------------------------------
SUPABASE_PROJECT_REF=YOUR-PROJECT-REF

# ---------------------------------------------------------------------------
# Server secrets (used only by Edge Functions; never sent to the app)
# Upload them with:  npm run secrets:dev
# ---------------------------------------------------------------------------
AI_API_KEY=your-deepinfra-key
AI_BASE_URL=https://api.deepinfra.com/v1/openai
AI_MODEL=google/gemma-4-31B-it
DAILY_MESSAGE_LIMIT=100

# Testing alone: lets you verify your own work. Keep false in production.
VERIFY_OWN_WORK=false
